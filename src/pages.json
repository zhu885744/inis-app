  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "INIS",
    "navigationBarBackgroundColor": "#fbf9f5",
    "backgroundColor": "#f6f1e8"
  },
  "uniIdRouter": {}
}
