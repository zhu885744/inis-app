    "@dcloudio/uni-mp-weixin": "3.0.0-5020620260917001",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.23",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3",
    "pinia": "^4.1.0",
    "vue": "^3.5.13",
    "wot-design-uni": "^1.14.0"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
